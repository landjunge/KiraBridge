                    "minLength": 1,
                    "title": "Idempotency Key",
                    "type": "string"
                  },
                  "body": {
                    "maxLength": 65536,
                    "minLength": 1,
                    "title": "Body",
                    "type": "string"
                  },
                  "kind": {
                    "default": "question",
                    "enum": [
                      "question",
                      "answer",
                      "work",
                      "result",
                      "note"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "message_id": {
                    "anyOf": [
                      {
                        "maxLength": 128,
                        "minLength": 1,
                        "pattern": "^[\\w-]+$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Message Id"
                  },
                  "reply_to": {
                    "anyOf": [
                      {
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Reply To"
                  },
                  "task_id": {
                    "anyOf": [
                      {
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Task Id"
                  },
                  "request_reply": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Request Reply"
                  },
                  "dispatch": {
                    "default": true,
                    "title": "Dispatch",
                    "type": "boolean"
                  }
                },
                "required": [
                  "recipient",
                  "conversation_id",
                  "idempotency_key",
                  "body"

      "text": "<!doctype html>\n<html lang=\"de\" data-theme=\"light\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Ein heller Moment</title>\n  <style>\n    :root { color-scheme: light; --bg: #f5f2eb; --card: #fffdf8; --text: #252d29; --muted: #59665e; --accent: #25664a; --line: #d7ded5; }\n    html[data-theme=\"dark\"] { color-scheme: dark; --bg: #17221d; --card: #223029; --text: #f1f4eb; --muted: #bdcbbf; --accent: #a3e1b9; --line: #46594b; }\n    * { box-sizing: border-box; }\n    body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; line-height: 1.6; }\n    main { width: min(100% - 2rem, 720px); margin: 0 auto; padding: 4rem 0; }\n    header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }\n    .brand { font-weight: 750; letter-spacing: .04em; }\n    button { padding: .7rem 1rem; border: 1px solid var(--accent); border-radius: 999px; background: var(--card); color: var(--accent); font: inherit; font-weight: 650; cursor: pointer; }\n    button:hover { background: var(--line); }\n    button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }\n    article { padding: clamp(1.5rem, 5vw, 3rem); border: 1px solid var(--line); border-radius: 24px; background: var(--card); }\n    .eyebrow { margin: 0; color: var(--accent); font-weight: 650; }\n    h1 { margin: .6rem 0 1rem; font-size: clamp(2rem, 7vw, 3.5rem); line-height: 1.15; letter-spacing: -.04em; }\n    p { color: var(--muted); }\n    footer { margin-top: 2rem; color: var(--muted); font-size: .9rem; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <span class=\"brand\">PAUSENZEIT</span>\n      <button id=\"theme\" type=\"button\" aria-pressed=\"false\">Dunkelmodus aktivieren</button>\n    </header>\n    <article>\n      <p class=\"eyebrow\">Weniger Trubel, mehr Ruhe.</p>\n      <h1>Ein kleiner Moment für dich.</h1>\n      <p>Atme durch, lass den Blick schweifen und gönn dir eine Pause vom Alltag.</p>\n      <p>Ob hell oder dunkel: Mit dem Schalter oben passt du diese Seite an deine Stimmung an.</p>\n    </article>\n    <footer>Einfach ankommen. Ganz ohne Eile.</footer>\n  </main>\n  <script>\n    const themeButton = document.getElementById('theme');\n    function applyTheme(theme) {\n      const dark = theme === 'dark';\n      document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n      themeButton.setAttribute('aria-pressed', String(dark));\n      themeButton.textContent = dark ? 'Hellmodus aktivieren' : 'Dunkelmodus aktivieren';\n    }\n\n    let savedTheme;\n    try {\n      savedTheme = localStorage.getItem('kirabridge-theme');\n    } catch {}\n    applyTheme(savedTheme === 'dark' || savedTheme === 'light'\n      ? savedTheme : document.documentElement.dataset.theme);\n\n    themeButton.addEventListener('click', () => {\n      const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';\n      applyTheme(theme);\n      try {\n        localStorage.setItem('kirabridge-theme', theme);\n      } catch {}\n    });\n  </script>\n</body>\n</html>\n",

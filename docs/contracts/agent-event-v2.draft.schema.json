      "event_id": "td-wb-000001",
      "timestamp": "2026-11-08T10:00:00Z",
      "trace_id": "tr-synth-0001",
      "span_id": "s-0001",
      "workflow_id": "wf-synth-1",
      "project_id": "proj-synth",

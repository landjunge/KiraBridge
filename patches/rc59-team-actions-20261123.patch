@@ -0,0 +1,141 @@
+import json
+from contextlib import asynccontextmanager
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+from jsonschema import Draft202012Validator
+
+from kirabridge.agent_manager import CodexAdapter, codex_output_schema
+from kirabridge.bridge_core.config import AgentConfig, TeamConfig
+from kirabridge.platform_adapters.codex_turn import NativeCodexTurns
+from kirabridge.team_manager.dispatcher import (
+    MessageAction,
+    TaskAction,
+    TeamDispatcher,
+    parse_team_turn,
+)
+
+
+@pytest.fixture
+def schema():
+    path = codex_output_schema(SimpleNamespace(output_schema=None), team_turn=True)
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def test_team_schema_matches_dispatcher(schema, tmp_path):
+    Draft202012Validator.check_schema(schema)
+    validator = Draft202012Validator(schema)
+    message = {
+        "type": "message",
+        "recipient": "worker",
+        "kind": "question",
+        "body": "Bitte prüfen",
+        "reply_to": None,
+    }
+    task = {"type": "task", "assignee": "worker", "title": "Test", "body": "Prüfen"}
+    envelope = {"kirabridge_team": "1", "result": "Ergebnis", "actions": [message, task]}
+    validator.validate(envelope)
+    turn = parse_team_turn(json.dumps(envelope, ensure_ascii=False))
+    assert [type(action) for action in turn.actions] == [MessageAction, TaskAction]
+    validator.validate({**envelope, "actions": []})
+    assert not validator.is_valid({**envelope, "actions": [message] * 5})
+    assert not validator.is_valid({**envelope, "actions": [{**message, "sender": "owner"}]})
+    assert not validator.is_valid({**envelope, "actions": [{"type": "shell"}]})
+
+    custom = tmp_path / "custom.json"
+    custom.write_text("{}", encoding="utf-8")
+    config = SimpleNamespace(output_schema=str(custom))
+    assert codex_output_schema(config) == custom
+    team_path = codex_output_schema(config, team_turn=True)
+    assert json.loads(team_path.read_text(encoding="utf-8")) == schema
+
+
+async def test_native_team_handoff_sends_schema_and_returns_exact_reply(schema, monkeypatch):
+    host = NativeCodexTurns()
+    binding = SimpleNamespace(thread_id="thread", session_id="session")
+    observed = {
+        "binding_sha256": "binding",
+        "thread_id": binding.thread_id,
+        "session_id": binding.session_id,
+        "thread_cwd": "/workspace",
+        "operation": "turn/start",
+        "expected_turn_id": None,
+    }
+    rpc = SimpleNamespace(call=AsyncMock(return_value={"turn": {"id": "turn"}}))
+
+    @asynccontextmanager
+    async def connection(binding):
+        yield rpc, "generation"
+
+    monkeypatch.setattr(host, "connection", connection)
+    monkeypatch.setattr(host, "observe", AsyncMock(return_value=observed))
+    reply = '{"kirabridge_team":"1","result":"Ergebnis","actions":[]}'
+    monkeypatch.setattr(host, "wait_reply", AsyncMock(return_value=reply))
+
+    result = await host.execute(
+        binding, "message", "Teamauftrag", 5, AsyncMock(), output_schema=schema
+    )
+
+    rpc.call.assert_awaited_once()
+    operation, params = rpc.call.await_args.args
+    assert operation == "turn/start"
+    assert params["outputSchema"] == schema
+    assert params["clientUserMessageId"] == "message"
+    host.wait_reply.assert_awaited_once_with(binding, "turn", "Teamauftrag", 5, cwd="/workspace")
+    assert result["text"] == result["final_message"] == reply
+
+
+async def test_managed_team_handoff_applies_only_final_actions(schema):
+    envelope = {
+        "kirabridge_team": "1",
+        "result": "Fertig",
+        "actions": [
+            {"type": "task", "assignee": "worker", "title": "Prüfen", "body": "Test"}
+        ],
+    }
+    final = json.dumps(envelope, ensure_ascii=False)
+
+    async def execute(
+        task_id, principal, args, roots, executables, spawned, *, line_callback, **kwargs
+    ):
+        argv = args.argv
+        path = Path(argv[argv.index("--output-schema") + 1])
+        assert json.loads(path.read_text(encoding="utf-8")) == schema
+        output = Path(argv[argv.index("--output-last-message") + 1])
+        output.write_text(final, encoding="utf-8")
+        for event in (
+            {"type": "thread.started", "thread_id": "session"},
+            {"type": "turn.started"},
+            {"type": "item.completed", "item": {"type": "agent_message", "text": "Zwischenstand"}},
+            {"type": "turn.completed"},
+        ):
+            await line_callback(json.dumps(event))
+        return {"exit_code": 0, "pid": 1, "timed_out": False, "terminated": False}
+
+    adapter = CodexAdapter(SimpleNamespace(execute=execute, environment={}))
+    core_result = await adapter.execute(
+        {"id": "core", "principal": "codex"},
+        SimpleNamespace(agent="codex", cwd="/workspace", timeout=5, prompt="Teamauftrag"),
+        AgentConfig(kind="codex", executable="/bin/codex"),
+        ["/workspace"],
+        AsyncMock(),
+        AsyncMock(),
+        team_turn=True,
+    )
+    assert core_result["text"] == core_result["final_message"] == final
+    teams = Mock()
+    config = SimpleNamespace(team=TeamConfig(), visible_handoffs=SimpleNamespace(enabled=False))
+    dispatcher = TeamDispatcher(SimpleNamespace(teams=teams, config=config))
+    dispatcher._call = AsyncMock(return_value={"id": "child"})
+    await dispatcher._complete(
+        None, {"id": "parent", "team_id": "team"}, {"id": "core", "result": core_result}
+    )
+    dispatcher._call.assert_awaited_once()
+    _, tool, arguments = dispatcher._call.await_args.args
+    assert tool == "team_work_create"
+    assert arguments["request"]["parent_id"] == "parent"
+    assert arguments["request"]["assignee"] == "worker"
+    teams.fail.assert_not_called()
+    assert teams.finish.call_args.args[:2] == ("parent", "Fertig")
